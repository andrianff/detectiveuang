generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  currency  String   @default("IDR")
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets           Wallet[]
  categories        Category[]
  budgets           Budget[]
  savingGoals       SavingGoal[] 
  allocationPockets AllocationPocket[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  balance   Float    @default(0)
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  type      String   // Bisa diset "INCOME" atau "EXPENSE"
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  budgets            Budget[]
  allocationPocketId String?
  allocationPocket   AllocationPocket? @relation(fields: [allocationPocketId], references: [id], onDelete: SetNull)
}

model Transaction {
  id              String   @id @default(cuid())
  walletId        String
  categoryId      String?
  title           String
  amount          Float
  note            String?
  transactionDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet          Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  limit      Float
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model AllocationPocket {
  id         String     @id @default(cuid())
  userId     String
  name       String
  percentage Float
  color      String?
  icon       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[] 
}

model SavingGoal {
  id        String    @id @default(cuid())
  userId    String
  title     String
  target    Float
  current   Float     @default(0)
  deadline  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  content   String
  // Kita gunakan dimensi 768 standar embedding model (seperti text-embedding-004 gemini)
  embedding Unsupported("vector(768)")? 
  createdAt DateTime @default(now())
}
